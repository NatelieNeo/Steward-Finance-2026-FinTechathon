# Copy to .env and adjust. Real environment variables take precedence over this file.

# --- Database ---------------------------------------------------------------
# SQLite for local development (default: data/steward.db). PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://steward:steward@localhost:5432/steward
DATABASE_URL=sqlite:///data/steward.db

# --- AI provider -------------------------------------------------------------
# auto: use Claude when ANTHROPIC_API_KEY is set, otherwise the offline rule-based agent.
STEWARD_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
STEWARD_LLM_MODEL=claude-opus-5-5
STEWARD_LLM_EFFORT=low

# --- Security ----------------------------------------------------------------
STEWARD_ENV=development        # production disables /api/docs
COOKIE_SECURE=false            # true behind HTTPS (also enables HSTS)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
STEP_UP_MINUTES=5
ALLOW_REGISTRATION=true

# --- Sandbox -----------------------------------------------------------------
DEMO_SEED=42
STEWARD_CURRENCY=SGD

# Test credentials for the local demo account used by scripts/run_demo_scenario.py and
# manual UI testing. Sandbox only: never reuse a real password here.
DEMO_EMAIL=alex@steward.demo
DEMO_PASSWORD=SandboxDemo2026
